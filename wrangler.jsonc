{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vive-ai",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "vars": {
    "NODE_ENV": "production",
    "PORT": "3001"
  },
  "env": {
    "development": {
      "vars": {
        "NODE_ENV": "development"
      }
    }
  }
}

